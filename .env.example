# Copy to .env for local development only. Never commit a filled .env file.
VITE_AUTH_ENABLED=false
# Leave DATABASE_URL empty to use the local PGlite preview database.
DATABASE_URL=

# Production URL of this application (required when configuring Better Auth).
BETTER_AUTH_URL=http://localhost:8080
# Generate a unique random secret for each deployed environment.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# OAuth credentials are not supplied by this repository. The current social
# sign-in integration is Grok-broker-specific and must be migrated/configured
# for the final production domain before enabling staff authentication.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Vercel production: connect a public Blob store to this Vercel project.
# Vercel manages BLOB_READ_WRITE_TOKEN automatically for a connected store; never commit its value.
BLOB_READ_WRITE_TOKEN=
# Exact public origin shown by the connected Blob store, e.g. https://<store-id>.public.blob.vercel-storage.com
IMAGE_PUBLIC_BASE_URL=

# Alternative for non-Vercel deployments: S3-compatible storage (AWS S3, Cloudflare R2, MinIO).
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# One-time initial administrator setup only. Configure a unique random value of at least 32 characters
# in Vercel (Preview and/or Production as appropriate), complete first-admin setup, then remove it.
ADMIN_SETUP_TOKEN=
